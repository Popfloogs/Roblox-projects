		countGui = duckPlayerGUI,
		playerCounts = 0,
		timer = 30
	},
	ball = {
		players = {},
		timerGui = ballTimerGui,
		countGui = ballPlayerGUI,
		playerCounts = 0,
		timer = 30
	}
}

local player = game.Players

--Functions

local function addPlr(plr, booth)
	local name = plr.Name
	if table.find(minigames["dart"]["players"], plr) == nil and table.find(minigames["duck"]["players"], plr) == nil and table.find(minigames["ball"]["players"], plr) == nil and minigames[booth]["playerCounts"] ~= 5 then
		table.insert(minigames[booth]["players"], plr)
		minigames[booth]["playerCounts"] += 1
		minigames[booth]["countGui"].Text = minigames[booth]["playerCounts"].."/5"
		print(minigames[booth]["players"])
	end
end

local function remvPlr(plr, booth)
	if table.find(minigames[booth]["players"], plr) ~= nil then
		minigames[booth]["playerCounts"] -= 1
		table.remove(minigames[booth]["players"], table.find(minigames[booth]["players"], plr))
		minigames[booth]["countGui"].Text = minigames[booth]["playerCounts"].."/5"
	end	
end

local function timer(plr, booth)
	local code = teleService:ReserveServer(82328795787899)
	if minigames[booth]["playerCounts"] == 1 then
		for i = minigames[booth]["timer"], 0, -1 do
			if minigames[booth]["playerCounts"] ~= 0 and i ~= 0 then
				minigames[booth]["timerGui"].Text = i
				wait(1)
			elseif i == 0 and minigames[booth]["playerCounts"] ~= 1 then
				local playersToTele = minigames[booth]["players"]
				local success, result = pcall(function()				
					teleService:TeleportToPrivateServer(82328795787899, code, playersToTele)
				end)
				if success then
					minigames[booth]["timerGui"].Text = minigames[booth]["timer"]
					remvPlr(plr, booth)
				end
			else
				minigames[booth]["timerGui"].Text = minigames[booth]["timer"]
				break
			end
		end
	end
end

dartEvent.OnServerEvent:Connect(function(plr)
	local booth = "dart"
