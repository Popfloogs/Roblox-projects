local TCActionPart = workspace.Rooms.Hallway.TimeClock:WaitForChild("ProxPart")
local TCCool = false

local termUpdate = require(game.ReplicatedStorage.Events.TermFuncs)



local UIS = game:GetService("UserInputService")
local plr = game.Players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local HRP = char:WaitForChild("HumanoidRootPart")
local s2Term = game.ReplicatedStorage.Events.Actions.Term.S2Term

local timeCheckStart
local timeCheckPunch

local branch2 = false

termUpdate.promptUpdate(plr, "")
termUpdate.promptUpdate(plr, "Please proceed to time clock")


while true do
	wait(1)
	
	if s2Term.Value == true or plr:GetAttribute('Term') == 'fin' then
		local actionGUI = plr.PlayerGui:WaitForChild("Action")
		actionGUI.Enabled = false
	end

	
	if (TCActionPart.Position - HRP.Position).Magnitude <= 10 then				
		if TCCool == false then
			TCCool = true
			branch2 = true
			local light = TCActionPart.Parent.light
			currenttime = DateTime.now()
			timeCheckStart = currenttime.UnixTimestamp
			termUpdate.promptUpdate(plr, "Press 'E' to punch in")
			plr:SetAttribute("punchStart", timeCheckStart)
		
			UIS.InputBegan:Connect(function(input)
				branch2 = false
				--FIXME: Make all actions governable by action buttons
				if input.KeyCode == Enum.KeyCode.E then
					light.Color = Color3.fromRGB(0, 255, 0)
					light.SpotLight.Color = Color3.fromRGB(0, 255, 0)
					currenttime = DateTime.now()
					timeCheckPunch = currenttime.UnixTimestamp
				
					if (currenttime.UnixTimestamp - timeCheckStart) < 30 then
						termUpdate.promptUpdate(plr, "Punch Accepted")
						plr:SetAttribute("punchTime", timeCheckPunch)
					
					elseif (currenttime.UnixTimestamp - timeCheckStart) > 30 then
						termUpdate.promptUpdate(plr, "Punch Accepted... late...")
						plr:SetAttribute("punchTime", timeCheckPunch)
					
					end

					task.delay(2, function()
						termUpdate.promptUpdate(plr, "Please proceed to workstation")
						light.Color = Color3.fromRGB(255, 0, 0)
						light.SpotLight.Color = Color3.fromRGB(255, 0, 0)
					end)
				end
			end)
		end
	end
	
	if branch2 == true then
		if (DateTime.now().UnixTimestamp - timeCheckStart) == 5 then
			termUpdate.promptUpdate(plr, "User punch timeout Error")

		elseif (DateTime.now().UnixTimestamp - timeCheckStart) == 10 then
			termUpdate.promptUpdate(plr, "User punch timeout Error")

		elseif (DateTime.now().UnixTimestamp - timeCheckStart) == 20 then
			termUpdate.promptUpdate(plr, "Punch in, " .. plr.Name .. "...")
			
		elseif (DateTime.now().UnixTimestamp - timeCheckStart) == 30 then
			local action = game.ReplicatedStorage.Events.Actions.TimeClock
			action:FireServer()
			termUpdate.promptUpdate(plr, "Critical Error: No punch detected...")
			wait(2)
			currenttime = DateTime.now()
			timeCheckPunch = currenttime.UnixTimestamp
			plr:SetAttribute("punchTime", timeCheckPunch)
			termUpdate.promptUpdate(plr, "Punch Accepted")
			termUpdate.promptUpdate(plr, "Please proceed to workstation")
		end
	end
end
