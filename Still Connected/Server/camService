game.Players.PlayerAdded:Connect(function(plr)
	local RoomData = require(game.ServerScriptService.Rooms)
	local Rooms = RoomData.Rooms
	local actuate = game.ReplicatedStorage.Events.Cams.Actuate

	local currRoom = "Entrance"
	local currCam = Rooms.Entrance.camAnchors[1]
	local distance = Rooms[currRoom].queueRadius + 2
	local camAnchors = Rooms[currRoom].camAnchors
	
	local function isPointInsidePart(part, point)
		local localPoint = part.CFrame:PointToObjectSpace(point)
		local halfSize = part.Size / 2

		return math.abs(localPoint.X) <= halfSize.X
			and math.abs(localPoint.Y) <= halfSize.Y
			and math.abs(localPoint.Z) <= halfSize.Z
	end
	


	local function GetRoom()
		local char = plr.Character or plr.CharacterAdded:Wait()
		local HRP = char:WaitForChild("HumanoidRootPart")

		for _, i in pairs(Rooms) do
			if i.queueRadius ~= nil then 
				distance = i.queueRadius + 2
			end
			--Rewrite using GetPartBoundsInBox for better rectangular detection.
			--Magnitude is spherical in nature.
			if (i.CameraSwitchTrigger.Position - HRP.Position).Magnitude <= distance then
				if i.Name == "Switch2Fp" then
					--When Fp is added this will need changed to make the proper switch
					local S2FP = game.ReplicatedStorage.Events.Actions.FirstPers.S2FP
					i.trapFunc(plr)
					S2FP:FireClient(plr)
					break
					
				elseif i.Name == "Switch2Term" then
					local S2Term = game.ReplicatedStorage.Events.Actions.Term.S2Term
				end
				
				
				local camAnchors = false
				local anchor
				local LV
				
				if i.camAnchors ~= nil then
					camAnchors = i.camAnchors
				end
				
				local camName = i.Name
				local queueRadius = i.queueRadius
				if camAnchors then 
					anchor = camAnchors[1].anchor.Position
					LV = camAnchors[1].cameraSubject.Position 
				end
				
				if i.trapFunc ~= nil then
					i.trapFunc(plr)
					i.trapFunc = nil
				end
				

				actuate:FireClient(plr, anchor, LV, camName)
				return currRoom
			else continue end
			
		end
	end
	
	while true do
		wait(1)
		GetRoom()
	end
end)
