local Room = require(game.ServerScriptService.RoomService)
local CamStates = require(game.ServerScriptService.CamStates)
local CamService = require(game.ServerScriptService.CamService)
local EnvironmentControl = require(game.ServerScriptService.EnvironmentControl)

game.Players.PlayerAdded:Connect(function(plr)

	local char = plr.Character or plr.CharacterAdded:Wait()
	local HRP = char:WaitForChild("HumanoidRootPart")
	local prevState = CamStates:getState()
	local prevRoom = Room.getRoom()
	local currState


	while true do
		--TESTING: This accelerates the game
		--plr:SetAttribute('Term', 'fin')
		
		wait(1)
		if plr:GetAttribute('Term') ~= true then
			local randNum = math.random(1, 8)
			local detectRoomChange = Room.detectPlayer(plr)
			local currRoom = Room.getRoom()
		
		
			if plr:GetAttribute('Term') ~= 'fin' then 
				local detectStateChange = CamStates.unpackState(currRoom)
				currState = CamStates.getState()
			else
				currState = 'FPV'
				EnvironmentControl.Check(plr)
			end
		
			print(currRoom.Name .. ", " .. currState)
		
			if currRoom.trapFunc ~= nil then
				if currRoom.trapCool ~= true then 
					currRoom.trapFunc(plr)
					currRoom.trapCool = true
					print("trapFunc called")
				end
			end
			CamService.sendCam(plr, currRoom, currState, randNum)
		end
		
			--prevRoom = currRoom
		--end
	end
end)
