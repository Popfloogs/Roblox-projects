local plr = game.Players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local H = char:WaitForChild("Humanoid")

local camUpdate = game.ReplicatedStorage.Events.Cams.CamUpdate

camUpdate.OnClientEvent:Connect(function(anchor, lv, camName, Cs)
	print("Cam received: Client")
	if Cs == 'Auto' then
		if anchor == nil then return end
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Scriptable
		cam.CFrame = CFrame.lookAt(anchor, lv)
		cam.FieldOfView = 40
		
	elseif Cs == 'FPV' then
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Custom
		task.wait()
		cam.CameraSubject = H
		cam.FieldOfView = 70

		plr.CameraMode = Enum.CameraMode.LockFirstPerson
		
	elseif Cs == 'Manual' then
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Custom
		task.wait()
		cam.CameraSubject = H
		cam.FieldOfView = 70
		
		plr.CameraMode = Enum.CameraMode.Classic
		plr.CameraMaxZoomDistance = 20
		plr.CameraMinZoomDistance = 20
	end
end)
