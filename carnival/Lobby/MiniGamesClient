local plr = game.Players.LocalPlayer
local DB = true

--touch defs darts
local dartQueue, dartEvent, dartEventEnd = workspace.Buildings.GameBooth["Dart Toss"]:WaitForChild("DartQueue"), game.ReplicatedStorage.Events.dartEvents.dartEvent, game.ReplicatedStorage.Events.dartEvents.dartEventEnd

dartQueue.Touched:Connect(function(Hit)
	if DB then
		if Hit.Parent == plr.Character then
			DB = false
			dartEvent:FireServer(plr)
		end
		DB = true
	end
	
end)
dartQueue.TouchEnded:Connect(function(Hit)
	if Hit.Parent == plr.Character then
		dartEventEnd:FireServer(plr)
	end
end)

