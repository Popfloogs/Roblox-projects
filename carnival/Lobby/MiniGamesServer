player.PlayerRemoving:Connect(function(plr)
	local  booth
	if minigames["dart"]["players"][plr] ~= nil or minigames["duck"]["players"][plr] ~= nil or minigames["ball"]["players"][plr] ~= nil then
		if minigames["dart"]["players"][plr] ~= nil then
			booth = "dart"
		elseif minigames["duck"]["players"][plr] ~= nil then
			booth = "duck"
		elseif minigames["ball"]["players"][plr] ~= nil then
			booth = "ball"
		end
		remvPlr(plr, booth)
	end
end)
