local EnvironmentControl = {}

function EnvironmentControl.Check(plr)
	if plr:GetAttribute('Term', 'fin') then
		game.Lighting.TimeOfDay = "23:59:59"
		game.Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
		
		local Rooms = game.Workspace:WaitForChild("Rooms")
		for _, room in pairs(Rooms:GetChildren()) do
			for _, part in pairs(room:GetChildren()) do
				if part.Name == "Light" then
					part.PointLight.Range = 0.5
					part.PointLight.Brightness = 0.1
				end
				if part.Name == "TimeClock" then
					part.light.SpotLight.Range = 10
					part.light.SpotLight.Brightness = 2
				end
				if room.Name == "Lounge" and part.Name == "Assets" then
					part.Door.Keypad.Light.SpotLight.Range = 10
					part.Door.Keypad.Light.SpotLight.Brightness = 2
				end
			end
		end
	end
end

return EnvironmentControl
