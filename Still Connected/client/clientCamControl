local actuate = game.ReplicatedStorage.Events.Cams.Actuate
local plr = game.Players.LocalPlayer
local S2FP = game.ReplicatedStorage.Events.Actions.FirstPers.S2FP

local actuated = actuate.OnClientEvent:Connect(function(cA, cLV, cN)
	if cA == nil and cLV == nil then return
	else
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Scriptable	
		cam.CFrame = CFrame.lookAt(cA, cLV)
		cam.FieldOfView = 40
	end
	plr:SetAttribute("camName", cN)	
end)

S2FP.OnClientEvent:Connect(function()
	actuated:Disconnect()
	local plr = game.Players.LocalPlayer
	local char = plr.Character or plr.CharacterAdded:Wait()
	local H = char:WaitForChild("Humanoid")
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	task.wait()
	cam.CameraSubject = H
	cam.FieldOfView = 70
	
	plr.CameraMode = Enum.CameraMode.LockFirstPerson	
end)
